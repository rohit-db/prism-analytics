{
  "datasets": [
    {
      "name": "spend_ds",
      "displayName": "Spend",
      "queryLines": [
        "SELECT travel_month, client_name, category, destination_region, travel_sector,\n  MEASURE(gross_spend_usd) AS spend_usd,\n  MEASURE(component_count) AS trips,\n  MEASURE(traveler_count) AS travelers\nFROM serverless_stable_71zsua_catalog.prism_travel.travel_metrics GROUP BY ALL"
      ]
    },
    {
      "name": "sus_ds",
      "displayName": "Sustainability",
      "queryLines": [
        "SELECT travel_month, client_name, category, destination_region, travel_sector,\n  MEASURE(total_emissions_advito) AS emissions_tco2e,\n  MEASURE(budget_remaining) AS budget_remaining,\n  MEASURE(emissions_per_km) AS kgco2e_per_km\nFROM serverless_stable_71zsua_catalog.prism_travel.travel_metrics GROUP BY ALL"
      ]
    }
  ],
