# Edge gateway config — copy to edge/.env and fill in (edge/.env is gitignored).
#
# The edge is the Firefly-style "front door": it hosts your public origin and
# reverse-proxies into the Databricks App using an edge Service Principal token,
# so end users never see Databricks SSO.

# --- Upstream Databricks App (behind the Apps OAuth proxy) -------------------
# The deployed app URL. Get it with:
#   databricks apps get advito-ai-bi -p bcd-customer | jq -r .url
EDGE_UPSTREAM_URL=https://advito-ai-bi-1048934788948873.aws.databricksapps.com

# --- Workspace OIDC endpoint (mints the edge SP token) -----------------------
# The workspace host, NOT the app URL. Tokens are minted at
# <EDGE_WORKSPACE_HOST>/oidc/v1/token.
EDGE_WORKSPACE_HOST=https://dbc-1e27e56a-90cd.cloud.databricks.com

# --- Edge Service Principal --------------------------------------------------
# An SP that has CAN_USE on the Databricks App above. This is the credential
# the edge presents to clear the Apps OAuth proxy. Create with:
#   python edge/create_edge_sp.py --profile bcd-customer --app-name advito-ai-bi
EDGE_SP_CLIENT_ID=
EDGE_SP_CLIENT_SECRET=

# --- Edge listener -----------------------------------------------------------
EDGE_HOST=127.0.0.1
EDGE_PORT=9000

# --- Local-http cookie handling ----------------------------------------------
# Strip `Secure` from upstream Set-Cookie so cookies survive over
# http://localhost. Set to 0 for any real https edge deployment.
EDGE_REWRITE_SECURE_COOKIES=1

# OAuth scope for the edge SP token (default all-apis; matches the app path).
EDGE_OAUTH_SCOPE=all-apis

# --- Custom authentication (edge IdP stand-in) -------------------------------
# Secret used to sign the edge's own session cookie. Change for any real
# deployment. End users sign in at /__edge/login (sample logins shown there);
# only then does the edge proxy into the Databricks App.
EDGE_SESSION_SECRET=apex-edge-dev-secret-change-me

# --- User directory (Lakebase managed Postgres) ------------------------------
# When enabled, login users are read from Lakebase instead of the in-code
# fallback list. Create the instance once with:
#   databricks postgres create-project apex-edge --json '{"spec":{"display_name":"APEX Edge Auth"}}' -p <profile>
# then seed users with:  python -m edge.seed_users
EDGE_LAKEBASE_ENABLED=0
# Endpoint host from: databricks postgres get-endpoint <endpoint-path> -p <profile>
EDGE_PG_HOST=
EDGE_PG_DATABASE=databricks_postgres
# Lakebase Autoscaling project id (reference only).
EDGE_PG_INSTANCE=apex-edge
# Endpoint resource path used to mint the database credential.
EDGE_PG_ENDPOINT=projects/apex-edge/branches/production/endpoints/primary
# Local dev: CLI profile whose user mints the Postgres credential. Leave blank
# in production to use the edge SP auth chain (the SP needs a Postgres role).
EDGE_PG_PROFILE=
# Postgres login identity: the user email (local dev) or SP client id (prod).
EDGE_PG_USER=
