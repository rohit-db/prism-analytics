# Cascade Hotels · Owner Portal — port 8002.
# Layered ON TOP of the repo .env (which supplies DATABRICKS_HOST + SP secrets), so this
# file holds NO credentials. Sourced and exported by demo/run-all.sh.

# --- Branding + copy (runtime, no rebuild) ---
BRAND_CONFIG_FILE=demo/brands/hotel.json
BRAND_ASSETS_DIR=demo/logos/hotel
CONTENT_CONFIG_FILE=demo/content/hotel.json

# --- Cookie MUST differ per instance: browsers scope cookies by host, IGNORING port,
#     so a shared name makes the three instances evict each other's sessions. ---
AUTH_SESSION_COOKIE=prism_hotel_session

# --- Data assets ---
UC_SCHEMA=hospitality_demo
KPI_METRIC_VIEW=serverless_stable_71zsua_catalog.hospitality_demo.hotel_metrics
# Quoted: this file is SOURCED by run-all.sh, so unquoted spaces would run the rest of
# the line as a command and leave the variable empty.
KPI_MEASURES="total_revenue:spend,avg_adr:adr,rooms_sold:rooms,reservation_count:trips"
# The metric view exposes only month-truncated date DIMENSIONS (stay_month,
# booking_month) — checkin_date is a column on hotel_stays, not on hotel_metrics.
KPI_DATE_COLUMN=stay_month
VERIFY_TABLE=serverless_stable_71zsua_catalog.hospitality_demo.hotel_stays

# Per-instance nav + dashboard wiring (see LAKEBASE_ENABLED note below).
ASSETS_SEED_FILE=demo/assets/hotel.seed.json

# "Prism Hotel Performance" — published, embed_credentials=false. (NOT the empty
# "Hotel Performance 2026-08-03T…" shell, which is unpublished and has zero widgets.)
DASHBOARD_IDS=01f1918a476c1402b644118695e2242d
DASHBOARD_URL=https://fevm-serverless-stable-71zsua.cloud.databricks.com/embed/dashboardsv3/01f1918a476c1402b644118695e2242d

# TODO: no Hospitality Genie space exists yet — set this when one is created, otherwise
# "Ask" on this instance falls back to the Travel space from the repo .env.
# GENIE_SPACE_ID=

# Off so the file-based registry above wins. Also means no row filter is wired for this
# schema — tenant isolation is demoed on Travel (port 8000) only.
LAKEBASE_ENABLED=false

# The seeded sample logins are travel-flavoured (Acme Travel / Globex), which reads wrong
# on this portal. Hide the chips; sign in with dana@prism.example / apex.
AUTH_SHOW_DEMO_LOGINS=false
