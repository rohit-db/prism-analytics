# Meridian Retail · Vendor Portal — port 8001.
# Layered ON TOP of the repo .env (which supplies DATABRICKS_HOST + SP secrets), so this
# file holds NO credentials. Sourced and exported by demo/run-all.sh.

# --- Branding + copy (runtime, no rebuild) ---
BRAND_CONFIG_FILE=demo/brands/retail.json
BRAND_ASSETS_DIR=demo/logos/retail
CONTENT_CONFIG_FILE=demo/content/retail.json

# --- Cookie MUST differ per instance: browsers scope cookies by host, IGNORING port,
#     so a shared name makes the three instances evict each other's sessions. ---
AUTH_SESSION_COOKIE=prism_retail_session

# --- Data assets ---
UC_SCHEMA=retail_merchandising_demo
KPI_METRIC_VIEW=serverless_stable_71zsua_catalog.retail_merchandising_demo.retail_metrics
# Quoted: this file is SOURCED by run-all.sh, so unquoted spaces would run the rest of
# the line as a command and leave the variable empty.
KPI_MEASURES="net_sales:spend,gross_margin:margin,units_sold:units,transactions:trips"
KPI_DATE_COLUMN=transaction_date
VERIFY_TABLE=serverless_stable_71zsua_catalog.retail_merchandising_demo.retail_sales

# Retail Merchandising Intelligence dashboard (published in FEVM).
DASHBOARD_IDS=01f18f35e0131e6293a3095ce556151b
DASHBOARD_URL=https://fevm-serverless-stable-71zsua.cloud.databricks.com/embed/dashboardsv3/01f18f35e0131e6293a3095ce556151b

# TODO: set once the parallel agent reports the Retail Genie space id.
# GENIE_SPACE_ID=

# Per-instance nav + dashboard wiring. Requires LAKEBASE_ENABLED=false below: the shared
# Lakebase registry takes precedence over this file, so with Lakebase on all three
# instances would show Travel's nav.
ASSETS_SEED_FILE=demo/assets/retail.seed.json

# Off so the file-based registry above wins. Also means no row filter is wired for this
# schema — tenant isolation is demoed on Travel (port 8000) only.
LAKEBASE_ENABLED=false

# The seeded sample logins are travel-flavoured (Acme Travel / Globex), which reads wrong
# on this portal. Hide the chips; sign in with dana@prism.example / apex.
AUTH_SHOW_DEMO_LOGINS=false
