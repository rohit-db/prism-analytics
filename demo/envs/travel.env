# Prism · Travel Intelligence — port 8000 (the BCD anchor).
# Layered ON TOP of the repo .env, which already points at prism_travel and supplies the
# SP secrets, so this file only adds the brand identity + logo assets. Unlike the other two
# instances it keeps LAKEBASE_ENABLED as-is (from .env) so conversation history, saved
# filters and the per-tenant SP isolation demo all work here.

# --- Branding + copy (runtime, no rebuild) ---
BRAND_CONFIG_FILE=demo/brands/travel.json
BRAND_ASSETS_DIR=demo/logos/travel
# No CONTENT_CONFIG_FILE: Travel IS the built-in default copy (server/content.py).

# Distinct cookie per instance (browsers scope cookies by host and ignore port).
AUTH_SESSION_COOKIE=prism_travel_session
